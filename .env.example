# Placeholder values only. Do not copy real credentials into the repository.
NORTHSTAR_ENV=production
NORTHSTAR_PRODUCTION_HOSTNAME=northstar.example.com
NORTHSTAR_AUTH_MODE=cloudflare
NORTHSTAR_DATABASE_PATH=/data/northstar.db
NORTHSTAR_BACKUP_DIR=/backups
NORTHSTAR_RUNTIME_ROOT=/runtime
NORTHSTAR_OPERATIONS_DIR=/runtime/operations
NORTHSTAR_REPLICATION_DIR=/mounted/encrypted-recovery
NORTHSTAR_SECRETS_PATH=/run/secrets/northstar.env
NORTHSTAR_DATABASE_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
NORTHSTAR_DATA_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
NORTHSTAR_BACKUP_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY
NORTHSTAR_BLIND_INDEX_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY
NORTHSTAR_SESSION_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
NORTHSTAR_KEY_VERSION=1
NORTHSTAR_BACKUP_DAILY_RETENTION=14
NORTHSTAR_BACKUP_MONTHLY_RETENTION=12
NORTHSTAR_CF_ISSUER=https://REPLACE.cloudflareaccess.com
NORTHSTAR_CF_AUDIENCE=REPLACE_WITH_ACCESS_APPLICATION_AUDIENCE
NORTHSTAR_ALLOWED_EMAIL=replace@example.com
NORTHSTAR_SECURE_COOKIES=1
NORTHSTAR_BIND_ADDRESS=127.0.0.1
NORTHSTAR_CONTAINER_NAME=northstar-local
NORTHSTAR_EXPECTED_CONTAINER_USER=10001:10001
NORTHSTAR_MINIMUM_FREE_BYTES=536870912

# Added only after the security scaffold and Schwab app approval.
NORTHSTAR_SCHWAB_ENABLED=0
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
